config.json
deploy/config.json
*.env
.env*

# 你的真实错题（db.json 里含 server_only 锁定答案）与每日备份
data/
deploy/data/
backups/
*.db.json

# 打包产物：87MB 的 exe + 分发 zip + 中间文件
dist/
build/
release/
*.exe
*.zip

# 部署目录是 build-deploy.js 生成的（里面还含带密钥的 config.json）
deploy/

# node_modules（本项目运行时零依赖，只有打包工具链会用到）
node_modules/

